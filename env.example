# =============================================================
#  IBM Cloud / Watsonx Configuration
# =============================================================

# IBM Watsonx.ai API Key (from IBM Cloud IAM)
WATSONX_API_KEY=your_ibm_cloud_api_key_here

# IBM Watsonx.ai Project ID (from your Watsonx project)
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# IBM Watsonx.ai URL (region-specific)
# US South  : https://us-south.ml.cloud.ibm.com
# EU De     : https://eu-de.ml.cloud.ibm.com
# EU GB     : https://eu-gb.ml.cloud.ibm.com
# JP Tokyo  : https://jp-tok.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# =============================================================
#  IBM Granite Model Configuration
# =============================================================

# Primary LLM  – IBM Granite 4 (instruct, supports text generation)
GRANITE_MODEL_ID=ibm/granite-4-h-small

# Embedding model for RAG vector store
GRANITE_EMBEDDING_MODEL=ibm/slate-30m-english-rtrvr-v2

# =============================================================
#  RAG / Vector Store Configuration
# =============================================================

# Directory where ChromaDB persists its data
CHROMA_PERSIST_DIR=./data/chroma_db

# Maximum number of retrieved chunks per query
RAG_TOP_K=5

# Chunk size (tokens) for document splitting
CHUNK_SIZE=512

# Chunk overlap (tokens)
CHUNK_OVERLAP=64

# =============================================================
#  Agent Behaviour
# =============================================================

# Max tokens for LLM responses
MAX_NEW_TOKENS=1024

# LLM temperature (0 = deterministic, 1 = creative)
TEMPERATURE=0.7

# Minimum probability for token sampling
TOP_P=0.9

# =============================================================
#  Application Settings
# =============================================================

# Server host and port (for FastAPI / Streamlit)
APP_HOST=0.0.0.0
APP_PORT=8000

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Data directory for uploaded resumes and knowledge base
DATA_DIR=./data
RESUME_DIR=./data/resumes
KB_DIR=./data/knowledge_base
